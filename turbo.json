{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "tsdown.config.mts"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!browser/tonal.min.js",
        "!browser/tonal.min.js.map"
      ],
      "outputs": [
        "dist/**",
        "browser/tonal.min.js",
        "browser/tonal.min.js.map"
      ]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
