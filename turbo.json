{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "tsdown.config.mts"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
