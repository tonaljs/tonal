{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docs": "node scripts/docs-from-readmes.mjs && node scripts/llms.mjs",
    "prebuild": "npm run docs",
    "build": "next build",
    "predev": "npm run docs",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "deploy": "npm run deploy:build && npm run deploy:github",
    "deploy:github": "gh-pages -d out/ -t",
    "deploy:build": "npm run build"
  },
  "dependencies": {
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.2",
    "fumadocs-ui": "16.19.3",
    "gh-pages": "^6.3.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smplr": "1.2.1",
    "tonal": "6.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
